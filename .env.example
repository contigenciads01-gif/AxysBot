# ---------------------------------------------------------------
# AXYSBOT - variaveis de ambiente
# Local: copie para .env.local. Vercel: Settings > Environment Variables.
# Nunca comite o .env.local.
# ---------------------------------------------------------------

# --- Acesso ao painel (so voce entra) ---
# Usuario do login (padrao: admin)
ADMIN_USER=admin
# Senha do login, 8+ caracteres
ADMIN_PASSWORD=
# Assina o cookie de sessao. Opcional se ENCRYPTION_MASTER_KEY existir.
SESSION_SECRET=

# --- Supabase (Project Settings > API Keys) ---
# Tambem aceita os nomes antigos: NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave secreta (sb_secret_...) ou a service_role legada. SO servidor.
SUPABASE_SECRET_KEY=

# --- X / Twitter API v2 (console.x.com > seu app > Keys and tokens) ---
# App tipo "Web App" (cliente confidencial), OAuth 2.0 ligado.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Tem que bater EXATAMENTE com a Callback URI cadastrada no app do X
X_REDIRECT_URI=https://seu-dominio.vercel.app/api/x/callback

# --- Anthropic (composer com IA) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Seguranca ---
# Protege as rotas de cron. O Vercel envia como Bearer. openssl rand -hex 32
CRON_SECRET=
# Cifra os tokens do X no banco (AES-256-GCM). openssl rand -hex 32
# Opcional se ENCRYPTION_MASTER_KEY existir: a chave e derivada dela.
TOKEN_ENCRYPTION_KEY=
# Chave mestra (nome usado no projeto antigo). Se definida, SESSION_SECRET e
# TOKEN_ENCRYPTION_KEY sao derivadas dela com rotulos diferentes.
ENCRYPTION_MASTER_KEY=
