# ---------------------------------------------------------------
# AXYSBOT - variaveis de ambiente
# Local: copie para .env.local. Vercel: Settings > Environment Variables.
# Nunca comite o .env.local.
# ---------------------------------------------------------------

# --- Acesso ao painel ---
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_MASTER_KEY=

# --- X / Twitter OAuth 2.0 & API Keys ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
